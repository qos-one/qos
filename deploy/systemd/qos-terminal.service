[Unit]
Description=QOS Terminal, web version (served to the browser through Caddy; talks to the bot API on 127.0.0.1:8000)
After=network-online.target qos-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/qos/terminal/current
# Engine env first (QOS_HOME, QOS_LOCAL_TOKEN_FILE, QOS_TRUSTED_ORIGINS), then the Terminal
# file, which wins on duplicate keys. Caddy forwards the public Host; without these the
# Terminal answers GET / with 403. Both files are optional so a missing one does not fail the unit.
EnvironmentFile=-/srv/qos/deploy.env
EnvironmentFile=-/srv/qos/terminal.env
Environment=IP=127.0.0.1
Environment=PORT=8080
Environment=BOT_API=http://127.0.0.1:8000
Environment=QOS_HOME=/srv/qos/home
Environment=QOS_PUBLIC_TERMINAL=1
Environment=QOS_WS_URL=/ws
ExecStart=/srv/qos/terminal/current/server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
