[Unit]
Description=QOS watchdog (API / Redis / IB Gateway checks, Telegram alerts)

[Service]
Type=oneshot
WorkingDirectory=/srv/qos/engine/bot
EnvironmentFile=/srv/qos/deploy.env
ExecStart=/srv/qos/engine/bot/.venv/bin/python scripts/watchdog.py --api-unit qos-api.service --port 8000
TimeoutStartSec=50
