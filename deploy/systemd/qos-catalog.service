[Unit]
Description=QOS data catalog update (bars from IB into the catalog)

[Service]
Type=oneshot
WorkingDirectory=/srv/qos/engine/bot
EnvironmentFile=/srv/qos/deploy.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run --frozen scripts/build_catalog.py --update
TimeoutStartSec=1h
Nice=10
