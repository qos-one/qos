# QOS — settings for this computer. Copy to .env in QOS_HOME (qos home init does this) and fill in what you need.
# Never commit .env. Every value is optional: leave it empty to turn the feature off or use the default.

# --- IBKR (the account and port are normally chosen in the Terminal at sign-in; set these only to force them) ---
IB_HOST=
IB_PORT=
IB_API_CLIENT_ID=
IB_ACCOUNT=

# --- Local services ---
REDIS_URL=redis://127.0.0.1:6379/0
BOT_API=http://127.0.0.1:8000

# --- Telegram alerts (empty = no alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- MCP server / AI assistant (mcp_server.py) ---
ASSISTANT_OPERATOR_ID=assistant
ASSISTANT_PIN=
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_BEARER_TOKEN=

# --- qos CLI, when the API has operators set up ---
QOS_OPERATOR_TOKEN=

# --- Send ticks to Databricks (scripts/ticks_to_databricks.py; leave empty if unused) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# --- QOS Cloud: data and agents (trading never depends on it) ---
QOS_CLOUD_URL=http://localhost:8090
# QOS_CLOUD_ENV=dev            dev = trust the Cloud's keys on first sign-in (loopback only); prod = pinned keys only
# QOS_CLOUD_TOKEN_STORE=keychain   keychain (macOS default) | file
